{
  "name": "pdf-editor",
  "version": "1.0.0",
  "description": "A simple PDF text editor",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "vendor:mupdf": "node scripts/vendor-mupdf.mjs",
    "test:browsers": "playwright test --config=playwright.cross-browser.config.js"
  },
  "dependencies": {
    "mupdf": "1.28.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "serve": "^14.2.0"
  }
}
